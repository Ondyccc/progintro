import numpy as np

class Vector2D:
    def __init__(self, x, y):
        self.x = x
        self.y = y

    def length(self):
        return np.sqrt(self.x**2 + self.y**2)
    def add(self, v):
        return Vector2D(self.x + v.x, self.y + v.y)



u = Vector2D(3, 4)
v = Vector2D(1, 0)

print(u,u.length())
print(u.add(v))
